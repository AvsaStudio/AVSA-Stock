# demo: local simulated data; kafka: simulated pipeline; alpaca: real IEX data
DATA_MODE=demo
# Create a free Alpaca account, then set these only in backend/.env.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

PORT=4000
NODE_ENV=development

# Optional infrastructure: uncomment these settings after starting Docker.
# Kafka
# KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_STOCKS=stock-prices
KAFKA_TOPIC_NEWS=financial-news
KAFKA_GROUP_ID=avsa-stock

# Redis
# REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cassandra
# CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_KEYSPACE=financial_data
CASSANDRA_USERNAME=cassandra
CASSANDRA_PASSWORD=cassandra

# AWS S3 / MinIO
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
S3_BUCKET=financial-dashboard
S3_REGION=us-east-1
